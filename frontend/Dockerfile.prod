# Imagen de producción del frontend: compila con Vite y sirve los estáticos con nginx.
#   docker build -f Dockerfile.prod --build-arg VITE_API_URL=https://api.midominio.com/api -t dentalsense-web .
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_API_URL
# Opcional: URL de la CDN desde la que se servirán los archivos de /assets.
ARG VITE_CDN_URL
ENV VITE_API_URL=$VITE_API_URL VITE_CDN_URL=$VITE_CDN_URL
RUN npm run build
# Versiones precomprimidas para que nginx no gaste CPU en cada petición.
RUN find dist -type f \( -name '*.js' -o -name '*.css' -o -name '*.svg' -o -name '*.html' \) -exec gzip -9 -k {} +

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
