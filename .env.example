# Copia este archivo a .env (en la raíz del repositorio).
DEBUG=True
# Obligatoria con DEBUG=False.
SECRET_KEY=
DB_NAME=mi_base_datos
DB_USER=admin
DB_PASSWORD=admin_password
DB_HOST=localhost
DB_PORT=5432
# IA generativa (asistente, resumen clínico, explicaciones). Sin clave, el sistema usa sus alternativas
# locales y el triaje sigue funcionando igual: siempre lo decide el motor local de PLN y reglas.
# Clave de Google AI Studio (https://aistudio.google.com/apikey); empieza por AIza.
GEMINI_API_KEY=tu_api_key_aqui
AI_MODEL=gemini-3.5-flash-lite

# Correo institucional (SMTP). Las credenciales temporales de cada paciente se envían por aquí.
# Sin EMAIL_HOST, los correos se escriben en la consola del backend (solo para desarrollo).
# EMAIL_HOST=smtp.tu-dominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-responder@tu-dominio.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=DentalSense <no-responder@tu-dominio.com>
# Dirección del portal que aparece en los correos.
# PORTAL_URL=http://localhost:5173

# Rendimiento (opcionales)
# Caché compartida en Redis. En Docker ya apunta al servicio «redis»; déjala vacía para usar la memoria del proceso.
# CACHE_URL=redis://redis:6379/1
# Segundos que los catálogos permanecen en caché (0 la desactiva).
# DATA_CACHE_SECONDS=600
# Las peticiones más lentas que esto (ms) se registran con su ruta y número de consultas.
# SLOW_REQUEST_MS=800
